# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НИКОГДА не должен попадать в публичный репозиторий / чат.

# Тестовое окружение по умолчанию. Для боевого режима поменять на:
# https://api.v5pay.com
V5PAY_BASE_URL=https://api-uat.v5pay.com

# Из личного кабинета V5Pay (Merchant Admin Console -> Приложения)
V5PAY_MERCHANT_NO=
V5PAY_APP_KEY=
V5PAY_SECRET_KEY=

# Публичный адрес ЭТОГО сервера + путь до callback-обработчика.
# V5Pay будет слать сюда уведомления о статусе платежа.
# Должен быть доступен по HTTPS из интернета.
PUBLIC_CALLBACK_URL=https://your-domain.example.com/v5pay/callback

PORT=3000

# Валюта платежа. Цены на сайте в рублях. Подтвердить у V5Pay (см. README).
V5PAY_CURRENCY=RUB

# Домены сайта, с которых разрешено вызывать /v5pay/create-payment (CORS),
# через запятую. Для превью Тильды добавьте адрес вида https://projectXXXX.tilda.ws
ALLOWED_ORIGINS=https://bambumaker.com,https://www.bambumaker.com
